#include <iostream>
using namespace std;

class SET{
public:
    int a[10], n;

    void in(int x){ n=x; for(int i=0;i<n;i++) cin>>a[i]; }

    void diff(SET b){
        for(int i=0;i<n;i++){
            int f=0;
            for(int j=0;j<b.n;j++)
                if(a[i]==b.a[j]) f=1;
            if(!f) cout<<a[i]<<" ";
        }
    }

    void sym(SET b){
        diff(b);
        b.diff(*this);
    }
};

int main(){
    SET A,B;
    int n,m;
    cin>>n; A.in(n);
    cin>>m; B.in(m);

    A.diff(B);
    cout<<endl;
    A.sym(B);
}
