#include <iostream>
#include <vector>
using namespace std;

void permute(vector<int> &arr, int l, int r) {
    if (l == r) {
        for (int x : arr)
            cout << x << " ";
        cout << endl;
        return;
    }

    for (int i = l; i <= r; i++) {
        swap(arr[l], arr[i]);        // swap
        permute(arr, l + 1, r);      // recurse
        swap(arr[l], arr[i]);        // backtrack
    }
}

int main() {
    vector<int> arr = {1, 2, 3};  // given digits
    permute(arr, 0, arr.size() - 1);
    return 0;
}
