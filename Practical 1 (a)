#include <iostream>
using namespace std;

class SET {
    int arr[50], size;

public:
    SET() { size = 0; }

    void add(int x) {
        arr[size++] = x;
    }

    bool isMember(int x) {
        for (int i = 0; i < size; i++)
            if (arr[i] == x)
                return true;
        return false;
    }
};

int main() {
    SET s;
    s.add(10);
    s.add(20);

    if (s.isMember(10))
        cout << "Present";
    else
        cout << "Not Present";

    return 0;
}
