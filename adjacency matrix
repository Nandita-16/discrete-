#include <stdio.h>

int main() {
    int n, i, j;
    int adj[100][100];
    int isComplete = 1;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);
        }
    }

    for(i = 0; i < n; i++) {
        for(j = 0; j < n; j++) {
            if(i == j) {
                if(adj[i][j] != 0) {
                    isComplete = 0;
                    break;
                }
            } else {
                if(adj[i][j] != 1) {
                    isComplete = 0;
                    break;
                }
            }
        }
        if(!isComplete)
            break;
    }

    if(isComplete)
        printf("The graph is a Complete Graph.\n");
    else
        printf("The graph is NOT a Complete Graph.\n");

    return 0;
}
