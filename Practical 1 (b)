#include <iostream>
using namespace std;

class SET {
    int a[10], n;
public:
    void input(int x) {
        n = x;
        for(int i = 0; i < n; i++) cin >> a[i];
    }

    void powerSet() {
        for(int i = 0; i < (1<<n); i++) {
            cout << "{ ";
            for(int j = 0; j < n; j++)
                if(i & (1<<j)) cout << a[j] << " ";
            cout << "}\n";
        }
    }
};

int main() {
    SET s;
    int n; cin >> n;
    s.input(n);
    s.powerSet();
}
