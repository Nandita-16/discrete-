#include <iostream>
using namespace std;

class SET{
public:
    int a[10], n;

    void in(int x){
        n=x;
        for(int i=0;i<n;i++) cin>>a[i];
    }

    void comp(SET u){
        for(int i=0;i<u.n;i++){
            bool f=0;
            for(int j=0;j<n;j++)
                if(u.a[i]==a[j]) f=1;
            if(!f) cout<<u.a[i]<<" ";
        }
    }
};

int main(){
    SET A,U;
    int n,m;
    cin>>n; A.in(n);
    cin>>m; U.in(m);
    A.comp(U);
}
