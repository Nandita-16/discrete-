#include <iostream>
using namespace std;

class SET{
public:
    int a[10], n;

    void in(int x){
        n=x;
        for(int i=0;i<n;i++) cin>>a[i];
    }

    void cart(SET b){
        for(int i=0;i<n;i++)
            for(int j=0;j<b.n;j++)
                cout<<"("<<a[i]<<","<<b.a[j]<<") ";
    }
};

int main(){
    SET A,B;
    int n,m;
    cin>>n; A.in(n);
    cin>>m; B.in(m);

    A.cart(B);
}
