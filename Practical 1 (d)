#include <iostream>
using namespace std;

class SET{
public:
    int a[10], n;

    void input(int x){
        n = x;
        for(int i=0;i<n;i++) cin >> a[i];
    }

    void uni(SET b){
        for(int i=0;i<n;i++) cout<<a[i]<<" ";
        for(int i=0;i<b.n;i++){
            bool f=0;
            for(int j=0;j<n;j++)
                if(b.a[i]==a[j]) f=1;
            if(!f) cout<<b.a[i]<<" ";
        }
        cout<<endl;
    }

    void inter(SET b){
        for(int i=0;i<n;i++)
            for(int j=0;j<b.n;j++)
                if(a[i]==b.a[j]) cout<<a[i]<<" ";
    }
};

int main(){
    SET A,B;
    int n,m;
    cin>>n; A.input(n);
    cin>>m; B.input(m);

    A.uni(B);
    A.inter(B);
}
